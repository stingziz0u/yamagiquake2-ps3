/* Same with overbright bits: TMU1 is GL_COMBINE with GL_RGB_SCALE 2
   (gl1_overbrightbits 2). The scale applies to rgb only. */
void main(float2 tc0 : TEXCOORD0, float2 tc1 : TEXCOORD1,
          uniform sampler2D tex0, uniform sampler2D tex1, out float4 oColor : COLOR)
{
    float4 t = tex2D(tex0, tc0) * tex2D(tex1, tc1);
    oColor = float4(saturate(t.rgb * 2.0), t.a);
}
